IF: if
ELSE: else
FOR: for
WHILE: while
SWITCH: switch
CASE: case
RETURN: return
PUBLIC: public
PRIVATE: private
STRUCT: struct
COPY: copy
MOVE: move
EXTERN: extern
OPERATOR: operator
READONLY: readonly
TRY: try
ABORT: abort
FAILS: fails
CATCH: catch
IMPORT: import
BLOCK: block
CONTINUE: continue
BREAK: break
DEFER: defer
COMPTIME: comptime
FLOW: flow

PLUS: \+
MINUS: -
TIMES: \*
DIVIDE: /
PERCENT: %
TILDE: ~
XOR: ^
EXCL: !
QUESTION: \?
DOT: \.
COMMA: ,
LSHIFT: <<
RSHIFT: >>

VERTLINE: \|
AMPERSAND: &

LOGICALOR: \|\|
LOGICALAND: &&

LPAREN: \(
RPAREN: \)
LBRACE: {
RBRACE: }
LBRACKET: \[
RBRACKET: \]
LCHEV: <
RCHEV: >

INCREMENT: \+\+
DECREMENT: \-\-
EQUALS: =
EEQUALS: ==
NEEQUALS: !=
ADDAS: \+=
SUBAS: -=
MULAS: \*=
DIVAS: /=
MODAS: %=
FLIPAS: ~=
XORAS: ^=
ORAS: \|=
ANDAS: &=
LSHAS: >>=
RSHAS: <<=

GTE: >=
LTE: <=

CHAR: '[^']'
STRING: "[^"]*"
NUMBER: [0-9]+(\.[0-9]+)?
IDENTIFIER: [a-zA-Z_][a-zA-Z0-9_]*
BOOL: true|false

BUILTIN_TYPE: bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|void

DOLLAR: $
RIGHTARROW: ->
COLON: :
SEMICOLON: ;
