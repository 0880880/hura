PROGRAM -> TL_STATEMENT | PROGRAM TL_STATEMENT

TL_STATEMENT -> FUNCTION | IMPORT_S | STRUCT_S

CODE_STATEMENT -> PM_EXPR SEMICOLON | IF_STATEMENT | FOR_STATEMENT | WHILE_STATEMENT | SWITCH_STATEMENT | TRY_STATEMENT | TRY_CATCH_STATEMENT | TRY_ABORT_STATEMENT | ASSIGN_STATEMENT | RETURN_STATEMENT | BREAK SEMICOLON | CONTINUE SEMICOLON | DEFER PM_EXPR SEMICOLON | FLOW SEMICOLON | CASE FACTOR COLON

IF_STATEMENT -> IF COMPTIME_OPT LPAREN PM_EXPR RPAREN BLOCK
FOR_STATEMENT -> FOR LPAREN ASSIGN_OPT SEMICOLON PM_EXPR SEMICOLON PM_EXPR RPAREN BLOCK
WHILE_STATEMENT -> WHILE LPAREN PM_EXPR RPAREN BLOCK
SWITCH_STATEMENT -> SWITCH LPAREN PM_EXPR RPAREN BLOCK
ASSIGN_OPT -> ASSIGN_DECL | PM_EXPR
ASSIGN_STATEMENT -> ASSIGN_DECL SEMICOLON
ASSIGN_DECL -> IDENTIFIER COLON TYPE EQUALS PM_EXPR
RETURN_STATEMENT -> RETURN PM_EXPR SEMICOLON

TRY_STATEMENT -> TRY BLOCK
TRY_CATCH_STATEMENT -> TRY BLOCK CATCH LPAREN ERRORS RPAREN BLOCK
TRY_ABORT_STATEMENT -> TRY ABORT BLOCK

STRUCT_S -> VISIBILITY OPT_EXTERN STRUCT IDENTIFIER LBRACE STRUCT_MEMBERS RBRACE

STRUCT_MEMBERS -> STRUCT_MEMBERS STRUCT_MEMBER | ε
STRUCT_MEMBER -> FUNCTION | VISIBILITY IDENTIFIER COLON TYPE EQUALS PM_EXPR SEMICOLON | VISIBILITY READONLY IDENTIFIER COLON TYPE EQUALS PM_EXPR SEMICOLON

FUNCTION -> VISIBILITY FN_NAME LPAREN PARAMS RPAREN FN_RETURNS BLOCK | VISIBILITY FN_MODS FN_NAME LPAREN PARAMS RPAREN FN_RETURNS BLOCK

COMPTIME_OPT -> COMPTIME | ε

FN_NAME -> IDENTIFIER | FN_OPS | TILDE IDENTIFIER
FN_OPS -> LBRACKET RBRACKET | PLUS | MINUS | TIMES | DIVIDE | INCREMENT | DECREMENT | TILDE | XOR | EXCL | AMPERSAND | VERTLINE | LOGICALAND | LOGICALOR

FN_RETURNS -> RIGHTARROW FN_RETURN_PARTS | ε
FN_RETURN_PARTS -> TYPE | FAILS LBRACE ERRORS RBRACE | TYPE FAILS LBRACE ERRORS RBRACE

ERRORS -> ERROR | ERRORS COMMA ERROR
ERROR -> DOLLAR IDENTIFIER DOLLAR

PARAMS -> PARAM_LIST | ε
PARAM_LIST -> PARAM | PARAM_LIST COMMA PARAM
PARAM -> IDENTIFIER COLON TYPE | IDENTIFIER COLON TYPE DOTS

IMPORT_S -> IMPORT PACKAGE SEMICOLON
PACKAGE -> IDENTIFIER | PACKAGE DOT IDENTIFIER

PM_EXPR -> ASSIGN_EXPR
PM_OP -> DOT | RIGHTARROW
UNARY_EXPR -> FACTOR | UNARY_OP UNARY_EXPR | TRY QUESTION UNARY_EXPR | COPY UNARY_EXPR | MOVE UNARY_EXPR
UNARY_OP -> PLUS | MINUS | TIMES | AMPERSAND | EXCL | TILDE
MUL_EXPR -> UNARY_EXPR | MUL_EXPR MUL_OP UNARY_EXPR
MUL_OP -> TIMES | DIVIDE | PERCENT
ADD_EXPR -> MUL_EXPR | ADD_EXPR ADD_OP MUL_EXPR
ADD_OP -> PLUS | MINUS
SHIFT_EXPR -> ADD_EXPR | SHIFT_EXPR SHIFT_OP ADD_EXPR
SHIFT_OP -> LSHIFT | RSHIFT
REL_EXPR -> SHIFT_EXPR | REL_EXPR REL_OP SHIFT_EXPR
REL_OP -> LCHEV | RCHEV | GTE | LTE
EQ_EXPR -> REL_EXPR | EQ_EXPR EQ_OP REL_EXPR
EQ_OP -> EEQUALS | NEEQUALS
AND_EXPR -> EQ_EXPR | AND_EXPR AMPERSAND EQ_EXPR
XOR_EXPR -> AND_EXPR | XOR_EXPR XOR AND_EXPR
OR_EXPR -> XOR_EXPR | OR_EXPR VERTLINE XOR_EXPR
LAND_EXPR -> OR_EXPR | LAND_EXPR LOGICALAND OR_EXPR
LOR_EXPR -> LAND_EXPR | LOR_EXPR LOGICALOR LAND_EXPR
COND_EXPR -> LOR_EXPR | LOR_EXPR QUESTION PM_EXPR COLON COND_EXPR
ASSIGN_EXPR -> COND_EXPR | UNARY_EXPR ASSIGN_OP ASSIGN_EXPR
ASSIGN_OP -> EQUALS | ADDAS | SUBAS | MULAS | DIVAS | MODAS | LSHAS | RSHAS | FLIPAS | ANDAS | XORAS | ORAS
FACTOR -> POSTFIX_EXPR
POSTFIX_EXPR -> PRIMARY | POSTFIX_EXPR LPAREN ARGS RPAREN | POSTFIX_EXPR LPAREN RPAREN | POSTFIX_EXPR LBRACKET DOTS RBRACKET | POSTFIX_EXPR LBRACKET PM_EXPR DOTS RBRACKET | POSTFIX_EXPR LBRACKET DOTS PM_EXPR RBRACKET | POSTFIX_EXPR LBRACKET PM_EXPR DOTS PM_EXPR RBRACKET | POSTFIX_EXPR LBRACKET PM_EXPR RBRACKET | POSTFIX_EXPR PM_OP IDENTIFIER | POSTFIX_EXPR INCREMENT | POSTFIX_EXPR DECREMENT
ARGS -> PM_EXPR | ARGS COMMA PM_EXPR
PRIMARY -> NUMBER | CHAR | STRING | BOOL | IDENTIFIER | ERROR | LPAREN PM_EXPR RPAREN

FN_MODS -> EXTERN | OPERATOR | EXTERN OPERATOR
OPT_EXTERN -> EXTERN | ε
VISIBILITY -> PUBLIC | PRIVATE

BLOCK -> LBRACE CODES RBRACE

CODES -> CODES CODE_STATEMENT | ε

TYPE -> TYPE_BASE TYPE_SUFFIX
TYPE_BASE -> BUILTIN_TYPE | IDENTIFIER
TYPE_SUFFIX -> TIMES TYPE_SUFFIX | AMPERSAND TYPE_SUFFIX | QUESTION | LBRACKET NUMBER RBRACKET TYPE_SUFFIX | ε
