PROGRAM:Program -> TL_STATEMENT | PROGRAM TL_STATEMENT

TL_STATEMENT:TopLevel -> FUNCTION | IMPORT_S | STRUCT_S

CODE_STATEMENT:Code -> EXPR SEMICOLON | IF_STATEMENT | FOR_STATEMENT | WHILE_STATEMENT | SWITCH_STATEMENT | TRY_STATEMENT | TRY_CATCH_STATEMENT | TRY_ABORT_STATEMENT | ASSIGN_STATEMENT | RETURN_STATEMENT | BREAK SEMICOLON | CONTINUE SEMICOLON | DEFER EXPR SEMICOLON | FLOW SEMICOLON | CASE UNARY_EXPR COLON

IF_STATEMENT:If -> IF COMPTIME_OPT:is_comptime LPAREN EXPR:condition RPAREN BLOCK:statements
FOR_STATEMENT:For -> FOR LPAREN ASSIGN_OPT:assign_opt SEMICOLON EXPR:condition SEMICOLON EXPR:increment RPAREN BLOCK:statements
WHILE_STATEMENT:While -> WHILE LPAREN EXPR:condition RPAREN BLOCK:statements
SWITCH_STATEMENT:Switch -> SWITCH LPAREN EXPR:expression RPAREN BLOCK:statements
ASSIGN_OPT:AssignOpt -> ASSIGN_DECL | EXPR
ASSIGN_STATEMENT:Assign -> ASSIGN_DECL:decl SEMICOLON
ASSIGN_DECL:AssignDecl -> IDENTIFIER:name COLON TYPE:type EQUALS EXPR:value
RETURN_STATEMENT:Return -> RETURN EXPR:ret SEMICOLON

TRY_STATEMENT:Try -> TRY BLOCK:statements
TRY_CATCH_STATEMENT:TryCatch -> TRY BLOCK:statements CATCH LPAREN ERRORS:errors RPAREN BLOCK:on_error
TRY_ABORT_STATEMENT:TryAbort -> TRY ABORT BLOCK:statements

STRUCT_S:Struct -> VISIBILITY OPT_EXTERN STRUCT STRUCT_NAME LBRACE STRUCT_MEMBERS RBRACE
STRUCT_NAME:StructName -> IDENTIFIER | IDENTIFIER LCHEV METATYPES RCHEV

STRUCT_MEMBERS:StructMembers -> STRUCT_MEMBERS STRUCT_MEMBER | ε
STRUCT_MEMBER:StructMember -> FUNCTION | VISIBILITY IDENTIFIER COLON TYPE EQUALS EXPR SEMICOLON | VISIBILITY READONLY IDENTIFIER COLON TYPE EQUALS EXPR SEMICOLON

FUNCTION:Function -> VISIBILITY FN_NAME LPAREN PARAMS RPAREN FN_RETURNS BLOCK | VISIBILITY FN_MODS FN_NAME LPAREN PARAMS RPAREN FN_RETURNS BLOCK

COMPTIME_OPT:ComptimeOpt -> COMPTIME | ε

FN_NAME:FunctionName -> IDENTIFIER | FN_OPS | TILDE IDENTIFIER | IDENTIFIER LCHEV METATYPES RCHEV
FN_OPS:FunctionOps -> LBRACKET RBRACKET | PLUS | MINUS | TIMES | DIVIDE | INCREMENT | DECREMENT | TILDE | XOR | EXCL | AMPERSAND | VERTLINE | LOGICALAND | LOGICALOR

FN_RETURNS:FunctionReturns -> RIGHTARROW FN_RETURN_PARTS | ε
FN_RETURN_PARTS:FunctionReturnParts -> TYPE | FAILS LBRACE ERRORS RBRACE | TYPE FAILS LBRACE ERRORS RBRACE

ERRORS:Errors -> ERROR | ERRORS COMMA ERROR
ERROR:Error -> DOLLAR IDENTIFIER DOLLAR

PARAMS:Params -> PARAM_LIST | ε
PARAM_LIST:ParamList -> PARAM | PARAM_LIST COMMA PARAM
PARAM:Param -> IDENTIFIER COLON TYPE | IDENTIFIER COLON TYPE DOTS

IMPORT_S:Import -> IMPORT IDENTIFIER COLON IDENTIFIER SEMICOLON

EXPR:Expr -> COND_EXPR | UNARY_EXPR ASSIGN_OP EXPR
ASSIGN_OP:AssignOp -> EQUALS | ADDAS | SUBAS | MULAS | DIVAS | MODAS | LSHAS | RSHAS | FLIPAS | ANDAS | XORAS | ORAS
COND_EXPR:CondExpr -> LOR_EXPR | LOR_EXPR QUESTION EXPR COLON COND_EXPR
LOR_EXPR:LORExpr -> LAND_EXPR | LOR_EXPR LOGICALOR LAND_EXPR
LAND_EXPR:LANDExpr -> OR_EXPR | LAND_EXPR LOGICALAND OR_EXPR
OR_EXPR:ORExpr -> XOR_EXPR | OR_EXPR VERTLINE XOR_EXPR
XOR_EXPR:XORExpr -> AND_EXPR | XOR_EXPR XOR AND_EXPR
AND_EXPR:ANDExpr -> EQ_EXPR | AND_EXPR AMPERSAND EQ_EXPR
EQ_EXPR:EQExpr -> REL_EXPR | EQ_EXPR EQ_OP REL_EXPR
EQ_OP:EQOp -> EEQUALS | NEEQUALS
REL_EXPR:RelExpr -> SHIFT_EXPR | REL_EXPR REL_OP SHIFT_EXPR
REL_OP:RelOp -> LCHEV | RCHEV | GTE | LTE
SHIFT_EXPR:ShiftExpr -> ADD_EXPR | SHIFT_EXPR SHIFT_OP ADD_EXPR
SHIFT_OP:ShiftOp -> LSHIFT | RSHIFT
ADD_EXPR:AddExpr -> MUL_EXPR | ADD_EXPR ADD_OP MUL_EXPR
ADD_OP:AddOp -> PLUS | MINUS
MUL_EXPR:MulExpr -> UNARY_EXPR | MUL_EXPR MUL_OP UNARY_EXPR
MUL_OP:MulOp -> TIMES | DIVIDE | PERCENT
UNARY_EXPR:UnaryExpr -> POSTFIX_EXPR | UNARY_OP UNARY_EXPR | TRY ABORT UNARY_EXPR | TRY QUESTION UNARY_EXPR | COPY UNARY_EXPR | MOVE UNARY_EXPR
UNARY_OP:UnaryOp -> PLUS | MINUS | TIMES | AMPERSAND | EXCL | TILDE
POSTFIX_EXPR:PostfixExpr -> PRIMARY | IDENTIFIER SUPER LCHEV TYPES RCHEV LPAREN RPAREN | IDENTIFIER SUPER LCHEV TYPES RCHEV LPAREN ARGS RPAREN | POSTFIX_EXPR LPAREN ARGS RPAREN | POSTFIX_EXPR LPAREN RPAREN | POSTFIX_EXPR LBRACKET DOTS RBRACKET | POSTFIX_EXPR LBRACKET EXPR DOTS RBRACKET | POSTFIX_EXPR LBRACKET DOTS EXPR RBRACKET | POSTFIX_EXPR LBRACKET EXPR DOTS EXPR RBRACKET | POSTFIX_EXPR LBRACKET EXPR RBRACKET | POSTFIX_EXPR PM_OP IDENTIFIER | POSTFIX_EXPR INCREMENT | POSTFIX_EXPR DECREMENT
PM_OP:PtrMemOp -> DOT | RIGHTARROW
ARGS:Args -> EXPR | ARGS COMMA EXPR
PRIMARY:Primary -> NUMBER | CHAR | STRING | BOOL | IDENTIFIER | ERROR | LPAREN EXPR RPAREN

FN_MODS:FunctionMods -> EXTERN | OPERATOR | EXTERN OPERATOR
OPT_EXTERN:ExternOpt -> EXTERN | ε
VISIBILITY:Visibility -> PUBLIC | PRIVATE

BLOCK:Block -> LBRACE CODES RBRACE

CODES:Codes -> CODES CODE_STATEMENT | ε

TYPE:Type -> TYPE_BASE TYPE_SUFFIX | TYPE_BASE LCHEV METATYPES RCHEV TYPE_SUFFIX
TYPES:Types -> TYPE | TYPES COMMA TYPE
METATYPES:Metatypes -> IDENTIFIER | METATYPES COMMA IDENTIFIER
TYPE_BASE:TypeBase -> BUILTIN_TYPE | IDENTIFIER
TYPE_SUFFIX:TypeSuffix -> TIMES TYPE_SUFFIX | AMPERSAND TYPE_SUFFIX | QUESTION | LBRACKET NUMBER RBRACKET TYPE_SUFFIX | ε
