PROGRAM -> TL_STATEMENT | PROGRAM TL_STATEMENT

TL_STATEMENT -> FUNCTION | IMPORT_S | STRUCT_S

CODE_STATEMENT -> EXPR | IF_STATEMENT | FOR_STATEMENT | WHILE_STATEMENT | ASSIGN_STATEMENT | REASSIGN_STATEMENT | RETURN_STATEMENT | BREAK SEMICOLON | CONTINUE SEMICOLON | DEFER PM_EXPR SEMICOLON

IF_STATEMENT -> IF LPAREN EXPR RPAREN BLOCK
FOR_STATEMENT -> FOR LPAREN ASSIGN_OPT SEMICOLON PM_EXPR SEMICOLON PM_EXPR RPAREN BLOCK
WHILE_STATEMENT -> WHILE LPAREN PM_EXPR RPAREN BLOCK
ASSIGN_OPT -> ASSIGN_STATEMENT | REASSIGN_STATEMENT
ASSIGN_STATEMENT -> IDENTIFIER COLON TYPE EQUALS PM_EXPR SEMICOLON
REASSIGN_STATEMENT -> IDENTIFIER EQUALS PM_EXPR SEMICOLON
RETURN_STATEMENT -> RETURN PM_EXPR SEMICOLON

// ERROR and try catch stuff and make types correct

STRUCT_S -> VISIBILITY OPT_EXTERN STRUCT IDENTIFIER LBRACE STRUCT_MEMBERS RBRACE

STRUCT_MEMBERS -> STRUCT_MEMBER | STRUCT_MEMBERS STRUCT_MEMBER | ε
STRUCT_MEMBER -> FUNCTION | VISIBILITY IDENTIFIER COLON TYPE EQUALS EXPR SEMICOLON

FUNCTION -> FN_MODS FN_NAME LPAREN PARAMS RPAREN FN_RETURNS BLOCK

FN_NAME -> IDENTIFIER | FN_OPS
FN_OPS -> LBRACKET RBRACKET | PLUS | MINUS | TIMES | DIVIDE | INCREMENT | DECREMENT | TILDE | XOR | EXCL | AMPERSAND | VERTLINE | LOGICALAND | LOGICALOR

FN_RETURNS -> RIGHTARROW FN_RETURN_PARTS | ε
FN_RETURN_PARTS -> TYPE | FAILS LBRACE ERRORS RBRACE | TYPE FAILS LBRACE ERRORS RBRACE

ERRORS -> ERROR | ERRORS COMMA ERROR
ERROR -> DOLLAR IDENTIFIER DOLLAR

PARAMS -> PARAM | PARAMS COMMA PARAM | ε
PARAM -> IDENTIFIER COLON TYPE

IMPORT_S -> IMPORT PACKAGE SEMICOLON
PACKAGE -> IDENTIFIER | PACKAGE DOT IDENTIFIER | ε

PM_EXPR -> UNARY_EXPR SEMICOLON | PM_EXPR PM_OP UNARY_EXPR SEMICOLON
PM_OP -> DOT | RIGHTARROW
UNARY_EXPR -> MUL_EXPR | UNARY_OP UNARY_EXPR
UNARY_OP -> PLUS | MINUS | TIMES | AMPERSAND | EXCL | TILDE;
MUL_EXPR -> ADD_EXPR | MUL_EXPR MUL_OP ADD_EXPR
MUL_OP -> TIMES | DIVIDE | PERCENT
ADD_EXPR -> SHIFT_EXPR | ADD_EXPR ADD_OP SHIFT_EXPR
ADD_OP -> PLUS | MINUS
SHIFT_EXPR -> REL_EXPR | SHIFT_EXPR SHIFT_OP REL_EXPR
SHIFT_OP -> LSHIFT | RSHIFT
REL_EXPR -> EQ_EXPR | REL_EXPR REL_OP EQ_EXPR
REL_OP -> LCHEV | RCHEV | GTE | LTE
EQ_EXPR -> AND_EXPR | EQ_EXPR EQ_OP AND_EXPR
EQ_OP -> EEQUALS | NEEQUALS
AND_EXPR -> XOR_EXPR | AND_EXPR AMPERSAND XOR_EXPR
XOR_EXPR -> OR_EXPR | XOR_EXPR XOR OR_EXPR
OR_EXPR -> LAND_EXPR | OR_EXPR VERTLINE LAND_EXPR
LAND_EXPR -> LOR_EXPR | LAND_EXPR LOGICALAND LOR_EXPR
LOR_EXPR -> FACTOR | LOR_EXPR LOGICALOR FACTOR
FACTOR -> PRIMARY | POSTFIX_EXPR
POSTFIX_EXPR -> FACTOR | POSTFIX_EXPR LPAREN ARGS RPAREN | POSTFIX_EXPR LPAREN RPAREN | POSTFIX_EXPR LBRACKET PM_EXPR RBRACKET | POSTFIX_EXPR DOT IDENTIFIER | POSTFIX_EXPR INCREMENT | POSTFIX_EXPR DECREMENT
ARGS -> PM_EXPR | ARGS COMMA PM_EXPR
PRIMARY -> NUMBER | CHAR | STRING | BOOL | IDENTIFIER | LPAREN PM_EXPR RPAREN

FN_MODS -> VISIBILITY OPT_EXTERN OPT_OPERATOR OPT_DECONSTRUCTOR
OPT_EXTERN -> EXTERN | ε
OPT_OPERATOR -> OPERATOR | ε
OPT_DECONSTRUCTOR -> TILDE | ε
VISIBILITY -> PUBLIC | PRIVATE

BLOCK -> LBRACE CODES RBRACE

CODES -> CODES CODE_STATEMENT | ε

TYPE -> BUILTIN_TYPE | IDENTIFIER
